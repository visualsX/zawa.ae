---
import Layout from "../../layouts/Layout.astro";
import Reveal from "../../components/shared/reveal.astro";
import { Image } from "astro:assets";
import { projects } from "../../data/portfolio";

const categories = [...new Set(projects.map((p) => p.category))];
const totalPhotos = projects.reduce((sum, p) => sum + p.gallery.length, 0);
const communities = new Set(projects.map((p) => p.area)).size;

const stats = [
  { value: projects.length, label: "Featured projects" },
  { value: communities, label: "Dubai communities" },
  { value: totalPhotos, label: "On-site photos" },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout
  title="Our Portfolio | Premium Landscape Projects by Zahra Al Warsan"
  description="Explore our completed projects across Dubai, from villa landscape and pool transformations to hydroponic greenhouses and coastal gardens."
>
  <Reveal />

  <!-- Hero -->
  <section
    class="relative z-20 w-full bg-forest pt-40 sm:pt-48 pb-20 sm:pb-28 px-4 sm:px-6 overflow-hidden"
  >
    <img
      src="/icons/phool.svg"
      alt=""
      aria-hidden="true"
      class="absolute pointer-events-none -right-10 top-24 w-72 md:w-96 opacity-10 hidden md:block animate-float-slow"
    />
    <div class="container-custom relative z-10">
      <span
        class="inline-flex items-center gap-2 font-sora text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-teal mb-6"
      >
        <span class="w-8 h-px bg-teal"></span>
        Our Portfolio
      </span>
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end"
      >
        <h1
          class="lg:col-span-7 font-awesome text-[2.75rem] sm:text-6xl md:text-7xl lg:text-[5.25rem] text-cream leading-[1.02]"
        >
          Gardens we've grown. Spaces we've transformed.
        </h1>
        <div class="lg:col-span-5 lg:pb-3">
          <p
            class="font-sora font-light text-cream/80 text-base sm:text-lg leading-relaxed mb-8"
          >
            A closer look at the villas, farms and coastal homes we've shaped
            across Dubai, from the first site visit to the finished landscape.
          </p>
          <dl class="grid grid-cols-3 gap-4 border-t border-cream/15 pt-6">
            {
              stats.map((stat) => (
                <div>
                  <dt class="sr-only">{stat.label}</dt>
                  <dd class="font-almendra font-bold text-4xl sm:text-5xl text-cream leading-none">
                    {pad(stat.value)}
                  </dd>
                  <dd class="font-sora text-[11px] sm:text-xs uppercase tracking-wider text-cream/50 mt-2">
                    {stat.label}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="relative z-20 bg-cream pt-12 sm:pt-16 pb-20 sm:pb-28 md:pb-32">
    <div class="container-custom">
      <!-- Filters -->
      <div
        class="flex flex-wrap items-center justify-between gap-4 pb-8 sm:pb-10 mb-12 sm:mb-20 border-b border-forest/10"
      >
        <div
          class="flex flex-wrap gap-2"
          role="group"
          aria-label="Filter projects by service"
          data-filter-group
        >
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="filter-chip"
          >
            All projects
            <span class="filter-count">{projects.length}</span>
          </button>
          {
            categories.map((category) => (
              <button
                type="button"
                data-filter={category}
                aria-pressed="false"
                class="filter-chip"
              >
                {category}
                <span class="filter-count">
                  {projects.filter((p) => p.category === category).length}
                </span>
              </button>
            ))
          }
        </div>
        <p class="font-sora text-sm text-forest/50" aria-live="polite">
          Showing <span data-filter-visible>{projects.length}</span> of {
            projects.length
          }
        </p>
      </div>

      <!-- Project list -->
      <div class="flex flex-col gap-20 sm:gap-28 lg:gap-36">
        {
          projects.map((project, i) => {
            const before = project.gallery.filter((g) => g.when === "before");
            const thumbs = project.gallery
              .filter((g) => g.when === "after" && g.image !== project.image)
              .slice(0, 3);
            const reversed = i % 2 === 1;
            return (
              <article
                data-project
                data-category={project.category}
                class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center"
              >
                <a
                  href={`/portfolio/${project.slug}`}
                  aria-label={`View case study: ${project.title}`}
                  data-reveal
                  class:list={[
                    "group relative block lg:col-span-7 rounded-3xl overflow-hidden shadow-elevated aspect-4/3",
                    reversed && "lg:order-last",
                  ]}
                >
                  <Image
                    src={project.image}
                    alt={project.title}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 640px, 100vw"
                    loading={i === 0 ? "eager" : "lazy"}
                    class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-linear-to-t from-forest/60 via-transparent to-transparent" />
                  <div class="absolute top-4 left-4 sm:top-5 sm:left-5 flex flex-wrap gap-2">
                    {before.length > 0 && (
                      <span class="font-sora text-[11px] sm:text-xs font-semibold uppercase tracking-wider bg-cream/90 text-forest px-3 py-1.5 rounded-full backdrop-blur-sm">
                        Before &amp; After
                      </span>
                    )}
                  </div>
                  <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 flex items-end justify-between gap-4">
                    <span class="inline-flex items-center gap-2 font-sora text-xs sm:text-sm text-cream/90">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                        <circle cx="9" cy="9" r="2" />
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                      </svg>
                      {project.gallery.length} photos
                    </span>
                    <span class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-cream text-forest flex items-center justify-center shrink-0 transition-all duration-500 group-hover:bg-teal group-hover:text-white group-hover:-rotate-45">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>

                <div
                  class="lg:col-span-5"
                  data-reveal
                  style="--reveal-delay: 120ms"
                >
                  <div class="flex items-center gap-4 mb-5">
                    <span class="font-almendra font-bold text-5xl sm:text-6xl text-olive/80 leading-none">
                      {pad(i + 1)}
                    </span>
                    <span class="h-px flex-1 bg-forest/15" />
                    <span class="font-sora text-xs font-semibold uppercase tracking-[0.18em] text-teal">
                      {project.category}
                    </span>
                  </div>
                  <h2 class="font-awesome text-3xl sm:text-4xl lg:text-[2.75rem] text-forest leading-[1.1] mb-4">
                    <a
                      href={`/portfolio/${project.slug}`}
                      class="hover:text-teal transition-colors"
                    >
                      {project.title}
                    </a>
                  </h2>
                  <p class="inline-flex items-start gap-2 font-sora text-sm text-forest/60 mb-5">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 shrink-0 text-teal"
                      aria-hidden="true"
                    >
                      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    {project.location}
                  </p>
                  <p class="font-sora font-light text-[15px] sm:text-base text-forest/80 leading-relaxed mb-6">
                    {project.description}
                  </p>
                  <ul class="flex flex-wrap gap-2 mb-8" aria-label="Project scope">
                    {project.scope.map((item) => (
                      <li class="font-sora text-xs text-forest/80 border border-forest/15 rounded-full px-3 py-1.5">
                        {item}
                      </li>
                    ))}
                  </ul>
                  <div class="flex items-center justify-between gap-6 flex-wrap">
                    <a
                      href={`/portfolio/${project.slug}`}
                      class="group/cta inline-flex items-center gap-3 bg-forest text-cream font-sora text-sm font-medium pl-6 pr-2 py-2 rounded-full hover:bg-teal transition-colors"
                    >
                      View case study
                      <span class="w-8 h-8 rounded-full bg-cream/15 flex items-center justify-center transition-transform group-hover/cta:translate-x-0.5">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14" />
                          <path d="m12 5 7 7-7 7" />
                        </svg>
                      </span>
                    </a>
                    {thumbs.length > 0 && (
                      <div class="hidden sm:flex -space-x-3" aria-hidden="true">
                        {thumbs.map((thumb) => (
                          <Image
                            src={thumb.image}
                            alt=""
                            width={96}
                            height={96}
                            class="w-12 h-12 rounded-full object-cover ring-[3px] ring-cream"
                          />
                        ))}
                        <span class="w-12 h-12 rounded-full bg-olive text-cream ring-[3px] ring-cream flex items-center justify-center font-sora text-xs font-semibold">
                          +{project.gallery.length - thumbs.length}
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-20 bg-cream pb-20 sm:pb-28 px-4 sm:px-0">
    <div class="container-custom">
      <div
        data-reveal
        class="relative overflow-hidden rounded-4xl bg-teal px-6 py-14 sm:px-12 sm:py-20 md:px-16 grid grid-cols-1 md:grid-cols-12 gap-8 items-end"
      >
        <img
          src="/icons/phool.svg"
          alt=""
          aria-hidden="true"
          class="absolute pointer-events-none -right-16 -bottom-16 w-72 sm:w-96 opacity-15"
        />
        <div class="relative md:col-span-8">
          <h2
            class="font-awesome text-4xl sm:text-5xl md:text-6xl text-cream leading-[1.05] mb-5"
          >
            Your garden could be next.
          </h2>
          <p class="font-sora font-light text-cream/85 text-base sm:text-lg max-w-xl">
            Book a free site assessment and we'll put together a design and plan
            tailored to your space, style and budget.
          </p>
        </div>
        <div class="relative md:col-span-4 flex md:justify-end">
          <a
            href="/contact"
            class="inline-flex items-center gap-3 bg-cream text-forest font-sora font-semibold px-8 py-4 rounded-full hover:bg-forest hover:text-cream transition-colors shadow-lg"
          >
            Start your project
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem 0.55rem 1.1rem;
    border-radius: 9999px;
    border: 1px solid rgb(15 51 43 / 0.15);
    font-family: var(--font-sora);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-forest);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .filter-chip:hover {
    border-color: rgb(15 51 43 / 0.4);
  }
  .filter-chip[aria-pressed="true"] {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }
  .filter-count {
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.4rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    background: rgb(15 51 43 / 0.08);
  }
  .filter-chip[aria-pressed="true"] .filter-count {
    background: rgb(243 231 207 / 0.15);
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>("[data-filter-group]");
  const buttons = group?.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-project]");
  const visibleCount = document.querySelector("[data-filter-visible]");

  buttons?.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b === button)),
      );
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === "all" || card.dataset.category === filter;
        card.hidden = !match;
        if (match) shown++;
      });
      if (visibleCount) visibleCount.textContent = String(shown);
    });
  });
</script>

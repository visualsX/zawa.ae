  </div>

  <script>
    function initMobileMenu() {
      const toggle = document.getElementById("mobile-menu-toggle");
      const menu = document.getElementById("mobile-menu");
      if (!toggle || !menu) return;
      if (toggle.dataset.initialized === "true") return;
      toggle.dataset.initialized = "true";

      const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menu.classList.toggle("is-open", open);
        document.documentElement.classList.toggle("menu-locked", open);
      };

      toggle.addEventListener("click", () => setOpen(!isOpen()));

      // Choosing any link closes the menu.
      menu.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => setOpen(false)),
      );

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen()) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Tapping outside the header closes it.
      document.addEventListener("click", (e) => {
        const header = document.getElementById("site-header");
        if (isOpen() && header && !header.contains(e.target as Node)) {
          setOpen(false);
        }
      });

      // Reset if the viewport grows past the mobile breakpoint.
      matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
        if (e.matches) setOpen(false);
      });
    }

    // function initGlassEffects() {
    //   const nav = document.getElementById("glass-nav");
    //   const shine = document.getElementById("glass-shine");
    //   if (!nav || !shine) return;
    //   if (nav.dataset.initialized === "true") return;
    //   nav.dataset.initialized = "true";

    //   nav.addEventListener("mousemove", (e) => {
    //     const rect = nav.getBoundingClientRect();
    //     const x = ((e.clientX - rect.left) / rect.width) * 100;
    //     const y = ((e.clientY - rect.top) / rect.height) * 100;
    //     nav.style.setProperty("--x", `${x}%`);
    //     nav.style.setProperty("--y", `${y}%`);
    //   });

    //   nav.addEventListener("mouseenter", () => {
    //     shine.style.opacity = "1";
    //   });

    //   nav.addEventListener("mouseleave", () => {
    //     shine.style.opacity = "0";
    //   });

    //   let ticking = false;
    //   function updateOnScroll() {
    //     const scrollY = window.scrollY;
    //     const progress = Math.min(scrollY / 120, 1);
    //     const blur = 12 + progress * 12;
    //     const bgOpacity = 0.5 + progress * 0.25;

    //     nav.style.backdropFilter = `blur(${blur}px) saturate(150%)`;
    //     (nav.style as any).webkitBackdropFilter =
    //       `blur(${blur}px) saturate(150%)`;
    //     nav.style.backgroundColor = `rgba(245, 231, 207, ${bgOpacity})`;

    //     ticking = false;
    //   }

    //   window.addEventListener("scroll", () => {
    //     if (!ticking) {
    //       requestAnimationFrame(updateOnScroll);
    //       ticking = true;
    //     }
    //   });

    //   updateOnScroll();
    // }

    function initDropdown() {
      const groups = document.querySelectorAll<HTMLElement>(
        "[data-dropdown-group]",
      );

      groups.forEach((group) => {
        if (group.dataset.initialized === "true") return;
        group.dataset.initialized = "true";

        const trigger = group.querySelector<HTMLButtonElement>(
          "[data-dropdown-trigger]",
        );
        const panel = group.querySelector<HTMLElement>("[data-dropdown-panel]");
        const chevron = group.querySelector<SVGElement>(
          "[data-dropdown-chevron]",
        );

        if (!trigger || !panel) return;

        let closeTimeout: ReturnType<typeof setTimeout>;
        let openedAt = 0;
        let suppressFocusOpen = false;
        const isOpen = () => trigger!.getAttribute("aria-expanded") === "true";

        function open() {
          clearTimeout(closeTimeout);
          if (isOpen()) return;
          openedAt = Date.now();
          panel!.classList.add("is-open");
          trigger!.setAttribute("aria-expanded", "true");
          chevron?.classList.add("rotate-180");
        }

        function closeNow() {
          clearTimeout(closeTimeout);
          panel!.classList.remove("is-open");
          trigger!.setAttribute("aria-expanded", "false");
          chevron?.classList.remove("rotate-180");
        }

        // Small grace period so moving the pointer from the trigger to the
        // panel (or brushing past an edge) doesn't snap it shut.
        function close() {
          clearTimeout(closeTimeout);
          closeTimeout = setTimeout(closeNow, 160);
        }

        group.addEventListener("mouseenter", open);
        group.addEventListener("mouseleave", close);

        // A click right after hover opened it shouldn't immediately shut it.
        trigger.addEventListener("click", () => {
          if (isOpen() && Date.now() - openedAt > 400) closeNow();
          else open();
        });

        // Keyboard: open when tabbing in, close when focus leaves.
        group.addEventListener("focusin", (e) => {
          const target = e.target as HTMLElement;
          if (suppressFocusOpen || !target.matches(":focus-visible")) return;
          open();
        });
        group.addEventListener("focusout", (e) => {
          if (!group.contains(e.relatedTarget as Node)) close();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            closeNow();
            suppressFocusOpen = true;
            trigger.focus();
            suppressFocusOpen = false;
          }
        });

        document.addEventListener("click", (e) => {
          if (!group.contains(e.target as Node)) closeNow();
        });

        // One highlight that glides between service cards, so moving across
        // them never blinks off and back on.
        const list = group.querySelector<HTMLElement>("[data-dropdown-list]");
        const highlight = group.querySelector<HTMLElement>(
          "[data-dropdown-highlight]",
        );
        if (list && highlight) {
          let hideTimeout: ReturnType<typeof setTimeout>;
          const moveTo = (el: HTMLElement) => {
            clearTimeout(hideTimeout);
            const visible = highlight.classList.contains("is-visible");
            // First appearance snaps into place; after that it slides.
            highlight.classList.toggle("no-slide", !visible);
            highlight.style.width = `${el.offsetWidth}px`;
            highlight.style.height = `${el.offsetHeight}px`;
            highlight.style.transform = `translate(${el.offsetLeft + 4}px, ${el.offsetTop + 4}px)`;
            void highlight.offsetWidth;
            highlight.classList.remove("no-slide");
            highlight.classList.add("is-visible");
          };
          const hide = () => {
            hideTimeout = setTimeout(
              () => highlight.classList.remove("is-visible"),
              80,
            );
          };
          list.querySelectorAll<HTMLElement>("li").forEach((li) => {
            li.addEventListener("mouseenter", () => moveTo(li));
            li.addEventListener("focusin", () => moveTo(li));
          });
          list.addEventListener("mouseleave", hide);
          list.addEventListener("focusout", (e) => {
            if (!list.contains(e.relatedTarget as Node)) hide();
          });
          trigger.addEventListener("click", () =>
            highlight.classList.remove("is-visible"),
          );
          group.addEventListener("mouseleave", () =>
            highlight.classList.remove("is-visible"),
          );
        }
      });
    }

    function initAll() {
      initMobileMenu();
      // initGlassEffects();
      initDropdown();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }

    document.addEventListener("astro:page-load", initAll);
  </script>
</header>

<style>
  /* Desktop services dropdown.
     Open: the surface unrolls from the top edge while items rise in, one
     after another. Close: a quick, quiet fade so it never lingers. */
  [data-dropdown-panel] {
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.22s;
  }
  /* Invisible bridge over the gap between the nav pill and the panel. */
  [data-dropdown-panel]::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 0.75rem;
  }
  [data-dropdown-panel].is-open {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s;
  }

  .dropdown-surface {
    opacity: 0;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top center;
    clip-path: inset(0 0 100% 0 round 2rem);
    transition:
      opacity 0.18s ease,
      transform 0.22s ease,
      clip-path 0.22s ease;
  }
  .is-open .dropdown-surface {
    opacity: 1;
    transform: none;
    clip-path: inset(0 0 0 0 round 2rem);
    transition:
      opacity 0.25s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dropdown-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .is-open .dropdown-item {
    opacity: 1;
    transform: none;
    transition:

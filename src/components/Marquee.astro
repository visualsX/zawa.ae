---
interface Props {
  items: string[];
  speed?: number; // seconds for one full loop
  pauseOnHover?: boolean;
  gap?: string; // space on each side of the separator, e.g. "1.5rem"
  textClass?: string;
  dotClass?: string;
  separator?: string;
}

const {
  items,
  speed = 25,
  pauseOnHover = true,
  gap = "1.5rem",
  textClass = "font-sans text-[clamp(0.8rem,2vw,1.4rem)] font-normal text-white tracking-[0.01em]",
  dotClass = "text-white text-base",
  separator = "•",
} = Astro.props;
---

<!--
  Seamless loop: the list is rendered twice and the track slides by exactly
  -50%. For that to line up, both copies must be identical and nothing may sit
  between them, so every item carries its own trailing separator (including
  the last), and spacing lives on the separator, not on flex gaps.
-->
<div
  class="marquee relative w-full overflow-hidden"
  data-pause-on-hover={pauseOnHover ? "" : undefined}
>
  <div
    class="marquee-track flex w-max items-center whitespace-nowrap"
    style={`--marquee-speed: ${speed}s;`}
  >
    {
      [0, 1].map((copy) => (
        <ul
          class="flex shrink-0 items-center"
          aria-hidden={copy === 1 ? "true" : undefined}
        >
          {items.map((item) => (
            <li class="flex shrink-0 items-center">
              <span class={textClass}>{item}</span>
              <span
                class={dotClass}
                style={`margin-inline: ${gap}`}
                aria-hidden="true"
              >
                {separator}
              </span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee-scroll var(--marquee-speed) linear infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Lives here (not as a Tailwind hover: utility) so it isn't outranked by the
     animation shorthand above, which resets play-state to running. */
  .marquee[data-pause-on-hover]:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

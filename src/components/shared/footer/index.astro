---
import { site } from "../../../data/site";
---

<!-- Spacer to allow scroll for parallax footer reveal -->
<div id="parallax-spacer" class="hidden lg:block w-full relative z-0"></div>
<!-- Parallax Footer (fixed behind content) -->
<footer
  id="parallax-footer"
  class="lg:fixed bottom-0 left-0 right-0 z-0 bg-[#0f9b8e] text-white lg:pt-[120px]"
>
  <div
    class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-16 md:pt-24 lg:pt-10 pb-6"
  >
    <!-- Top Row: Logo + Info + Nav -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[auto_1fr_auto] gap-8 sm:gap-12 md:gap-16 items-start"
    >
      <!-- Logo -->
      <a
        href="/"
        class="bg-cream/25 rounded-2xl w-20 h-20 sm:w-28 sm:h-28 md:w-32 md:h-32 flex items-center justify-center p-3 sm:p-4 shrink-0"
      >
        <img
          src="/logo.png"
          alt="Zahra Al Warsan"
          class="w-full h-full object-contain"
        />
      </a>

      <!-- Middle: Tagline + Contact -->
      <div class="flex flex-col gap-4 sm:gap-6 sm:col-span-1 md:col-span-1">
        <p
          class="font-sora font-normal text-xs sm:text-sm md:text-lg text-white/80 leading-relaxed max-w-md"
        >
          Your eco-conscious partner, always available.<br />
          Comprehensive services for thriving landscapes.
        </p>
        <div
          class="flex flex-col sm:flex-row flex-wrap gap-4 sm:gap-6 md:gap-10"
        >
          <div class="flex items-center gap-2">
            <span class="text-white/60 text-lg" aria-hidden="true">→</span>
            <div>
              <span
                class="block text-xs sm:text-sm text-white/60 font-sora font-medium tracking-wider"
                >email</span
              >
              <a
                href={`mailto:${site.email}`}
                class="font-sora text-xs sm:text-sm text-white hover:text-white/80 transition-colors break-all sm:break-normal"
                >{site.email}</a
              >
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-white/60 text-lg" aria-hidden="true">→</span>
            <div>
              <span
                class="block text-xs sm:text-sm text-white/60 font-sora font-medium tracking-wider"
                >call us</span
              >
              <a
                href={site.phone.href}
                class="font-sora text-xs sm:text-sm text-white hover:text-white/80 transition-colors"
                >{site.phone.display}</a
              >
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-white/60 text-lg" aria-hidden="true">→</span>
            <div>
              <span
                class="block text-xs sm:text-sm text-white/60 font-sora font-medium tracking-wider"
                >request</span
              >
              <a
                href="/contact"
                class="font-sora text-xs sm:text-sm text-white hover:text-white/80 transition-colors"
                >Get a free quote</a
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Navigation -->
      <nav class="flex flex-col gap-2 sm:gap-3 pb-10 md:pb-0">
        <a
          href="/services/landscape-design"
          class="font-sora text-xs sm:text-sm font-medium text-white/90 hover:text-white transition-colors"
          >Landscaping Services</a
        >
        <a
          href="/services/ag-tech-solutions"
          class="font-sora text-xs sm:text-sm font-medium text-white/90 hover:text-white transition-colors"
          >Agri-Tech Services</a
        >
        <a
          href="/services/plant-care"
          class="font-sora text-xs sm:text-sm font-medium text-white/90 hover:text-white transition-colors"
          >Plant Care Services</a
        >
        <a
          href="/portfolio"
          class="font-sora text-xs sm:text-sm font-medium text-white/90 hover:text-white transition-colors"
          >Portfolio</a
        >
        <a
          href="/contact"
          class="font-sora text-xs sm:text-sm text-white/90 hover:text-white transition-colors"
          >Give us a call</a
        >
      </nav>
    </div>

    <!-- Big tagline -->
    <h2
      class="font-awesome text-3xl sm:text-5xl md:text-7xl lg:text-8xl text-white leading-[0.95] mb-6 sm:mb-10"
    >
      The new standard of<br />indoor & outdoor living
    </h2>

    <!-- Bottom bar -->
    <div
      class="border-t border-white/20 pt-4 sm:pt-5 flex flex-col sm:flex-row justify-between items-center gap-3"
    >
      <p
        class="font-sora text-[10px] sm:text-xs text-white/50 text-center sm:text-left"
      >
        © 2026 Zahra Al Warsan. Made by <a
          href="https://www.visualsx.io/"
          class="underline hover:text-white/70 transition-colors">visualsX</a
        >. All rights reserved.
      </p>
    </div>
  </div>

  <!-- Wordmark: SVG keeps it exactly edge-to-edge at every width -->
  <div class="relative overflow-hidden pointer-events-none select-none" aria-hidden="true">
    <svg
      viewBox="0 0 1000 96"
      class="block w-full h-auto"
      preserveAspectRatio="xMidYMax meet"
    >
      <defs>
        <linearGradient id="footer-wordmark-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.22" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
        </linearGradient>
      </defs>
      <text
        x="500"
        y="106"
        text-anchor="middle"
        textLength="980"
        lengthAdjust="spacingAndGlyphs"
        font-family="Sora Variable, ui-sans-serif, system-ui, sans-serif"
        font-weight="800"
        font-size="126"
        letter-spacing="-4"
        fill="url(#footer-wordmark-fill)"
      >Zahra Al Warsan</text>
    </svg>
  </div>
</footer>

<script>
  // The footer is fixed behind the page on desktop; the spacer reserves its
  // height so it can be revealed. Observe the footer itself so the spacer stays
  // in sync with font loading, wrapping and viewport changes.
  const footer = document.getElementById("parallax-footer");
  const spacer = document.getElementById("parallax-spacer");
  if (footer && spacer) {
    const sync = () => {
      spacer.style.height = `${footer.offsetHeight - 100}px`;
    };
    sync();
    new ResizeObserver(sync).observe(footer);
  }
</script>

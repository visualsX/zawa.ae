                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>

        <!-- Help card -->
        <div
          class="mobile-item rounded-3xl bg-forest text-cream p-5 mt-1"
          style="--i: 6"
        >
          <p class="font-almendra text-lg text-mist mb-1">
            Not sure where to start?
          </p>
          <p class="font-sora text-[13px] leading-relaxed text-cream/70 mb-4">
            Book a free site visit and we'll suggest the right services for
            your space.
          </p>
          <div class="grid grid-cols-2 gap-2">
            <a
              href="/contact"
              class="inline-flex items-center justify-center bg-teal text-white font-sora text-sm font-medium px-4 py-3 rounded-full hover:bg-cream hover:text-forest transition-colors"
            >
              Free visit
            </a>
            <a
              href={site.phone.href}
              class="inline-flex items-center justify-center gap-2 border border-cream/25 text-cream font-sora text-sm font-medium px-4 py-3 rounded-full hover:bg-cream/10 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              Call us
            </a>

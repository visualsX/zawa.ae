---
const values = [
  {
    tag: "Hospitality",
    title: "For your yard,<br />not to it",
    body: "We bring a hospitality approach to everything we do. That not only includes our customers but the yards we service as well. There is dignity in caring for something that is so important to the health and happiness of our customers.",
  },
  {
    tag: "Safety",
    title: "Do no harm<br />(to the good guys)",
    body: "Everything we do is considerate of the impact it has on the health and wellbeing of the whole household and the broader community. We don't do anything that would harm a productive or valued part of your home, whether that be flora, fauna or family.",
  },
  {
    tag: "People",
    title: "Care for people who<br />care for yards",
    body: "Our people treat our customers with warmth, commitment and care, ensuring their yards are safe, healthy spaces they can enjoy. In order for them to do that, we must treat our people with the same warmth, commitment and care.",
  },
];
---

<section class="w-full bg-olive py-20 sm:py-28 md:py-32 relative z-20">
  <div
    class="container-custom grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16"
  >
    <!-- Intro -->
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-36">
        <span
          class="inline-block font-almendra text-xl sm:text-2xl text-mist mb-5"
        >
          What we stand for
        </span>
        <h2
          class="font-awesome text-[2.75rem] sm:text-6xl md:text-7xl lg:text-[5.25rem] text-cream leading-[1.02] mb-6 sm:mb-8"
        >
          Our Values
        </h2>
        <p
          class="font-sora font-light text-cream/80 text-base sm:text-lg leading-relaxed max-w-md"
        >
          Three principles shape how we treat your garden, your family and our
          own team, on every visit and every project.
        </p>
      </div>
    </div>

    <!-- Values -->
    <ol class="lg:col-span-7 flex flex-col gap-4 sm:gap-5">
      {
        values.map((value, i) => (
          <li class="value-card group relative overflow-hidden rounded-4xl bg-cream/[0.07] border border-cream/15 p-7 sm:p-10 transition-colors duration-500 hover:bg-cream/[0.12] hover:border-cream/25">
            <span
              class="pointer-events-none select-none absolute -right-2 -top-6 sm:-top-8 font-almendra font-bold text-[8rem] sm:text-[11rem] leading-none text-cream/[0.07] transition-colors duration-500 group-hover:text-mist/20"
              aria-hidden="true"
            >
              0{i + 1}
            </span>
            <div class="relative">
              <span class="inline-flex items-center gap-2 font-sora text-xs sm:text-sm font-semibold text-forest bg-mist rounded-full px-3 py-1.5 mb-6 sm:mb-8">
                <span class="font-almendra text-sm leading-none">
                  0{i + 1}
                </span>
                {value.tag}
              </span>
              <h3
                class="font-almendra text-3xl sm:text-4xl text-cream leading-[1.15] mb-4 sm:mb-5"
                set:html={value.title}
              />
              <p class="font-sora font-light text-[15px] sm:text-base text-cream/80 leading-relaxed max-w-xl">
                {value.body}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

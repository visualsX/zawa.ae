                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </a>
                <a
                  href="/portfolio"
                  class="inline-flex items-center justify-center font-sora text-sm text-cream/80 py-2 rounded-full border border-cream/20 hover:bg-cream/10 hover:text-cream transition-colors"
                >
                  See our work
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <a
        href="/portfolio"
        class="text-[15px] text-forest font-sora font-medium flex items-center gap-1 hover:opacity-80 transition-opacity"
      >
        Portfolio
      </a>
      <a
        href="/contact"
        class="text-[15px] text-forest font-sora font-medium flex items-center gap-1 hover:opacity-80 transition-opacity"
      >
        Contact
      </a>
    </nav>

    <!-- Right side: CTA + hamburger -->
    <div class="relative flex items-center gap-2 sm:gap-3">
      <!-- CTA -->

      <a
        href="/contact"

---
import { Image } from "astro:assets";
import { site } from "../../../data/site";
import siteVisit from "../../../assets/portfolio/remi-before.jpeg";
import staging from "../../../assets/portfolio/remi-before2.jpeg";
import crew from "../../../assets/portfolio/mehdi7.jpeg";
import finished from "../../../assets/portfolio/remi3.jpeg";

const steps = [
  {
    title: "Connect",
    body: "Call us to book a free site assessment. We work with you to develop a personalized maintenance and design plan that reflects your style and aspirations.",
    image: siteVisit,
    caption: "Site assessment, Tilal Al Ghaf",
    cta: { label: "Give us a call", href: site.phone.href },
  },
  {
    title: "Plan & approve",
    body: "Get a detailed proposal. Once approved, we schedule the work with a dedicated team.",
    image: staging,
    caption: "Plants staged to plan, Tilal Al Ghaf",
  },
  {
    title: "Project execution",
    body: "Our skilled crew meticulously executes your project, ensuring exceptional results for both installation and ongoing maintenance.",
    image: crew,
    caption: "Topiary work in progress, Palm Jumeirah",
  },
  {
    title: "Completion & enjoyment",
    body: "Celebrate your completed landscape and explore our ongoing maintenance options to ensure its lasting beauty.",
    image: finished,
    caption: "The same corner, finished, Tilal Al Ghaf",
  },
];
---

<section
  class="how w-full bg-forest py-20 sm:py-28 md:py-32 relative z-20"
  data-how
>
  <div class="container-custom">
    <!-- Header -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-14 sm:mb-20 lg:mb-24"
    >
      <div class="lg:col-span-7">
        <span
          class="inline-block font-almendra text-xl sm:text-2xl text-teal mb-5"
        >
          Our process
        </span>
        <h2
          class="font-awesome text-[2.75rem] sm:text-6xl md:text-7xl lg:text-[5.25rem] text-cream leading-[1.02]"
        >
          How it works
        </h2>
      </div>
      <div class="lg:col-span-5 lg:pb-3">
        <p
          class="font-sora font-light text-cream/75 text-base sm:text-lg leading-relaxed mb-7"
        >
          Our team of passionate landscape professionals combines proven
          expertise with a dedication to exceeding your expectations. Four
          simple steps take you from first call to finished garden.
        </p>
        <a
          href="/contact"
          class="group/cta inline-flex items-center gap-3 bg-teal text-white font-sora text-sm font-medium pl-6 pr-2 py-2 rounded-full hover:bg-cream hover:text-forest transition-colors"
        >
          Get a free quote
          <span
            class="w-8 h-8 rounded-full bg-white/15 flex items-center justify-center transition-transform group-hover/cta:translate-x-0.5"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Steps + sticky visual -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16">
      <!-- Sticky visual (desktop) -->
      <div class="hidden lg:block lg:col-span-7 lg:order-last">
        <div
          class="sticky top-36 h-[calc(100svh-11rem)] max-h-200 rounded-4xl overflow-hidden bg-cream/5"
        >
          {
            steps.map((step, i) => (
              <Image
                src={step.image}
                alt={step.caption}
                widths={[640, 960, 1200]}
                sizes="(min-width: 1152px) 640px, 55vw"
                loading={i === 0 ? "eager" : "lazy"}
                data-how-image={i}
                class:list={[
                  "how-image absolute inset-0 w-full h-full object-cover",
                  i === 0 && "is-active",
                ]}
              />
            ))
          }
          <div
            class="absolute inset-0 bg-linear-to-t from-forest/70 via-transparent to-transparent pointer-events-none"
          >
          </div>
          <div
            class="absolute bottom-5 left-5 right-5 sm:bottom-7 sm:left-7 sm:right-7 flex items-end justify-between gap-4"
          >
            <p
              class="font-sora text-sm text-cream bg-forest/60 backdrop-blur-md rounded-full px-4 py-2"
              data-how-caption
              aria-live="polite"
            >
              {steps[0].caption}
            </p>
            <div class="flex gap-2" aria-hidden="true">
              {
                steps.map((_, i) => (
                  <span
                    data-how-dot={i}
                    class:list={["how-dot", i === 0 && "is-active"]}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Steps -->
      <ol class="lg:col-span-5 flex flex-col gap-16 sm:gap-20 lg:gap-0">
        {
          steps.map((step, i) => (
            <li
              class:list={[
                "how-step lg:min-h-[70svh] flex flex-col justify-center",
                i === 0 && "is-active",
              ]}
              data-how-step={i}
            >
              <Image
                src={step.image}
                alt={step.caption}
                widths={[480, 800]}
                sizes="100vw"
                loading="lazy"
                class="lg:hidden w-full aspect-4/3 object-cover rounded-3xl mb-8"
              />
              <span class="border border-cream/60 rounded-full w-12 h-16 sm:w-14 sm:h-20 flex items-center justify-center font-awesome text-2xl sm:text-3xl md:text-4xl text-cream mb-5 sm:mb-6">
                {i + 1}
              </span>
              <h3 class="font-awesome text-4xl sm:text-5xl lg:text-[3.5rem] text-cream leading-[1.05] mb-4 sm:mb-5">
                {step.title}
              </h3>
              <p class="font-sora font-light text-[15px] sm:text-base md:text-lg text-cream/75 leading-relaxed max-w-md">
                {step.body}
              </p>
              {step.cta && (
                <a
                  href={step.cta.href}
                  class="self-start inline-flex items-center gap-2 border border-cream/40 text-cream px-6 py-3 rounded-full text-sm font-sora hover:bg-cream hover:text-forest transition-colors mt-7"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  {step.cta.label}
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  :global(.how-image) {
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.8s ease,
      transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.how-image.is-active) {
    opacity: 1;
    transform: scale(1);
  }

  .how-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgb(243 231 207 / 0.35);
    transition:
      background-color 0.4s,
      transform 0.4s;
  }
  .how-dot.is-active {
    background: var(--color-cream);
    transform: scale(1.35);
  }

  /* Dim the steps that aren't in focus, desktop only and only once the
     script is running, so content is never hidden without JS. */
  @media (min-width: 1024px) {
    .how[data-enhanced] .how-step {
      opacity: 0.3;
      transition: opacity 0.5s ease;
    }
    .how[data-enhanced] .how-step.is-active {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.how-image),
    .how-dot,
    .how[data-enhanced] .how-step {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-how]");
  if (section && "IntersectionObserver" in window) {
    const steps = [
      ...section.querySelectorAll<HTMLElement>("[data-how-step]"),
    ];
    const images = section.querySelectorAll<HTMLElement>("[data-how-image]");
    const dots = section.querySelectorAll<HTMLElement>("[data-how-dot]");
    const caption = section.querySelector("[data-how-caption]");
    const captions = [...images].map((img) => img.getAttribute("alt") ?? "");

    const activate = (index: number) => {
      steps.forEach((el, i) => el.classList.toggle("is-active", i === index));
      images.forEach((el, i) => el.classList.toggle("is-active", i === index));
      dots.forEach((el, i) => el.classList.toggle("is-active", i === index));
      if (caption) caption.textContent = captions[index];
    };

    // The step crossing the middle band of the viewport is the active one.
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activate(Number((entry.target as HTMLElement).dataset.howStep));
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
    );
    steps.forEach((step) => observer.observe(step));
    section.dataset.enhanced = "";
  }
</script>

---
// Fades `[data-reveal]` elements up as they scroll into view.
// Content stays visible if JS is off or the user prefers reduced motion.
---

<script is:inline>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("reveal-ready");
  }
</script>

<script>
  function initReveal() {
    const root = document.documentElement;
    if (!root.classList.contains("reveal-ready")) return;

    const targets = document.querySelectorAll<HTMLElement>(
      "[data-reveal]:not(.is-revealed)",
    );
    if (!("IntersectionObserver" in window)) {
      targets.forEach((el) => el.classList.add("is-revealed"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        });
      },
      // Threshold 0: tall blocks (like the inquiry form) can never reach a
      // percentage threshold while only their top edge is on screen.
      { rootMargin: "0px 0px -60px 0px", threshold: 0 },
    );
    targets.forEach((el) => observer.observe(el));
  }

  initReveal();
</script>

<style is:global>
  .reveal-ready [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .reveal-ready [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }
</style>

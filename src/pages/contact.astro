---
import Layout from "../layouts/Layout.astro";
import Reveal from "../components/shared/reveal.astro";

const CONTACT_EMAIL = "zahraalwarsan@gmail.com";

const services = [
  { value: "Landscape design", slug: "landscape-design" },
  { value: "Pool & hardscape", slug: "hardscape" },
  { value: "Plant care & maintenance (AMC)", slug: "plant-care" },
  { value: "Pest control", slug: "pest-control" },
  { value: "Irrigation systems", slug: "irrigation" },
  { value: "Greenhouse & Ag-Tech", slug: "ag-tech-solutions" },
  { value: "Something else", slug: "other" },
];

const propertyTypes = [
  "Villa",
  "Apartment / balcony",
  "Commercial",
  "Farm",
  "School / community",
];

const budgets = [
  "Under AED 25k",
  "AED 25k to 75k",
  "AED 75k to 150k",
  "AED 150k+",
  "Not sure yet",
];

const timelines = ["As soon as possible", "1 to 3 months", "3 to 6 months", "Just exploring"];

const contactMethods = ["Phone call", "WhatsApp", "Email"];

const inputClass =
  "w-full px-4 py-3.5 rounded-xl border border-forest/15 bg-white/60 font-sora text-[15px] text-forest placeholder:text-forest/35 outline-none focus:border-teal focus:bg-white focus:ring-4 focus:ring-teal/15 transition-all";
---

<Layout
  title="Contact Zahra Al Warsan | Start Your Landscape Project in Dubai"
  description="Tell us about your garden, villa or farm project in Dubai. Share a few details and our team will get back to you within 24 hours with next steps."
>
  <Reveal />

  <!-- Hero -->
  <section
    class="relative z-20 w-full bg-forest pt-40 sm:pt-48 pb-20 sm:pb-24 px-4 sm:px-6 overflow-hidden"
  >
    <img
      fetchpriority="high"
      src="/icons/contact.svg"
      alt=""
      aria-hidden="true"
      class="absolute pointer-events-none -right-6 top-24 w-72 md:w-80 opacity-10 hidden md:block animate-float-slow"
    />
    <div class="container-custom relative z-10">
      <span
        class="inline-flex items-center gap-2 font-sora text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-teal mb-6"
      >
        <span class="w-8 h-px bg-teal"></span>
        Project Inquiry
      </span>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        <h1
          class="lg:col-span-7 font-awesome text-[2.75rem] sm:text-6xl md:text-7xl lg:text-[5.25rem] text-cream leading-[1.02]"
        >
          Tell us about the space you want to grow.
        </h1>
        <div class="lg:col-span-5 lg:pb-3">
          <p
            class="font-sora font-light text-cream/80 text-base sm:text-lg leading-relaxed mb-8"
          >
            A few quick answers help us understand your project before we call.
            It takes about two minutes, and we reply within 24 hours.
          </p>
          <ol class="grid grid-cols-3 gap-4 border-t border-cream/15 pt-6">
            {
              ["Share details", "Free site visit", "Tailored proposal"].map(
                (step, i) => (
                  <li>
                    <span class="block font-almendra font-bold text-3xl sm:text-4xl text-cream leading-none">
                      0{i + 1}
                    </span>
                    <span class="block font-sora text-[11px] sm:text-xs uppercase tracking-wider text-cream/50 mt-2">
                      {step}
                    </span>
                  </li>
                ),
              )
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Inquiry -->
  <section class="relative z-20 bg-cream py-16 sm:py-24 md:py-28">
    <div
      class="container-custom grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14"
    >
      <!-- Form -->
      <div class="lg:col-span-7 lg:order-last" data-reveal>
        <form
          id="inquiry-form"
          novalidate
          class="rounded-4xl bg-white/45 border border-white/70 shadow-elevated p-6 sm:p-10"
        >
          <!-- 01 Services -->
          <fieldset class="form-step" data-group="service">
            <legend class="step-legend">
              <span class="step-num">01</span>
              What can we help with?
            </legend>
            <p class="step-hint">Pick everything that applies.</p>
            <div class="flex flex-wrap gap-2.5">
              {
                services.map((s) => (
                  <label class="choice">
                    <input
                      type="checkbox"
                      name="service"
                      value={s.value}
                      data-slug={s.slug}
                      class="peer sr-only"
                    />
                    <span class="choice-pill">
                      <svg
                        class="choice-tick"
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {s.value}
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" data-error-for="service" hidden>
              Please choose at least one service.
            </p>
          </fieldset>

          <!-- 02 Property -->
          <fieldset class="form-step">
            <legend class="step-legend">
              <span class="step-num">02</span>
              About your property
            </legend>
            <p class="step-hint">Type of property</p>
            <div class="flex flex-wrap gap-2.5 mb-6">
              {
                propertyTypes.map((type) => (
                  <label class="choice">
                    <input type="radio" name="property" value={type} class="peer sr-only" />
                    <span class="choice-pill">{type}</span>
                  </label>
                ))
              }
            </div>
            <label for="inq-location" class="field-label"
              >Community or area</label
            >
            <input
              id="inq-location"
              name="location"
              type="text"
              autocomplete="address-level2"
              placeholder="e.g. Palm Jumeirah, Tilal Al Ghaf, Al Awir"
              class={inputClass}
            />
          </fieldset>

          <!-- 03 Budget & timeline -->
          <fieldset class="form-step">
            <legend class="step-legend">
              <span class="step-num">03</span>
              Budget & timeline
            </legend>
            <p class="step-hint">Approximate budget (optional)</p>
            <div class="flex flex-wrap gap-2.5 mb-6">
              {
                budgets.map((b) => (
                  <label class="choice">
                    <input type="radio" name="budget" value={b} class="peer sr-only" />
                    <span class="choice-pill">{b}</span>
                  </label>
                ))
              }
            </div>
            <p class="step-hint">When would you like to start?</p>
            <div class="flex flex-wrap gap-2.5">
              {
                timelines.map((t) => (
                  <label class="choice">
                    <input type="radio" name="timeline" value={t} class="peer sr-only" />
                    <span class="choice-pill">{t}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 04 Details -->
          <fieldset class="form-step">
            <legend class="step-legend">
              <span class="step-num">04</span>
              Tell us more
            </legend>
            <label for="inq-message" class="field-label"
              >Project details <span class="text-forest/40 font-normal">(optional)</span></label
            >
            <textarea
              id="inq-message"
              name="message"
              rows="5"
              maxlength="1200"
              placeholder="What do you have in mind? Size of the area, the style you like, anything we should know."
              class={`${inputClass} resize-none`}></textarea>
          </fieldset>

          <!-- 05 Contact -->
          <fieldset class="form-step">
            <legend class="step-legend">
              <span class="step-num">05</span>
              How can we reach you?
            </legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
              <div class="sm:col-span-2">
                <label for="inq-name" class="field-label">Full name</label>
                <input
                  id="inq-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Your name"
                  class={inputClass}
                />
                <p class="field-error" data-error-for="name" hidden>
                  Please tell us your name.
                </p>
              </div>
              <div>
                <label for="inq-email" class="field-label">Email</label>
                <input
                  id="inq-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="you@example.com"
                  class={inputClass}
                />
                <p class="field-error" data-error-for="email" hidden>
                  Please enter a valid email address.
                </p>
              </div>
              <div>
                <label for="inq-phone" class="field-label">Phone</label>
                <input
                  id="inq-phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="+971 XX XXX XXXX"
                  class={inputClass}
                />
              </div>
            </div>
            <p class="step-hint">Preferred way to contact you</p>
            <div class="flex flex-wrap gap-2.5">
              {
                contactMethods.map((m, i) => (
                  <label class="choice">
                    <input
                      type="radio"
                      name="contactMethod"
                      value={m}
                      checked={i === 0}
                      class="peer sr-only"
                    />
                    <span class="choice-pill">{m}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- Submit -->
          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 pt-8 border-t border-forest/10"
          >
            <p
              class="inline-flex items-start gap-2 font-sora text-xs text-forest/55 max-w-xs leading-relaxed"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-teal"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              Opens your email app with your inquiry ready to send. Nothing is
              sent until you press Send there.
            </p>
            <button
              type="submit"
              class="group inline-flex items-center justify-center gap-3 bg-forest text-cream font-sora font-semibold pl-8 pr-2.5 py-2.5 rounded-full hover:bg-teal transition-colors shadow-lg cursor-pointer"
            >
              Send inquiry
              <span
                class="w-10 h-10 rounded-full bg-cream/15 flex items-center justify-center transition-transform group-hover:translate-x-0.5"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </button>
          </div>
        </form>

        <!-- After opening the email app -->
        <div
          data-sent
          hidden
          tabindex="-1"
          class="rounded-4xl bg-forest text-cream p-8 sm:p-12 shadow-elevated outline-none"
        >
          <span
            class="w-14 h-14 rounded-full bg-teal/20 text-teal flex items-center justify-center mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </span>
          <h2 class="font-awesome text-4xl sm:text-5xl leading-[1.05] mb-4">
            Almost done, <span data-sent-name></span>.
          </h2>
          <p
            class="font-sora font-light text-cream/80 text-base sm:text-lg leading-relaxed mb-8 max-w-lg"
          >
            Your email app should now be open with your inquiry filled in. Just
            press <strong class="font-semibold text-cream">Send</strong> and we'll
            get back to you within 24 hours <span
              data-sent-method
              class="text-cream font-medium">by phone</span>.
          </p>

          <div class="rounded-2xl bg-cream/5 border border-cream/10 p-5 sm:p-6 mb-8">
            <p class="font-sora text-sm font-semibold text-cream mb-1">
              Email app didn't open?
            </p>
            <p class="font-sora text-sm text-cream/60 mb-5">
              Copy your inquiry and paste it into an email to <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="text-cream underline underline-offset-2 hover:text-teal">{CONTACT_EMAIL}</a
              >.
            </p>
            <div class="flex flex-wrap gap-3">
              <button
                type="button"
                data-copy
                class="inline-flex items-center gap-2 bg-teal text-white font-sora text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-[#0c8478] transition-colors cursor-pointer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                </svg>
                <span data-copy-label>Copy inquiry</span>
              </button>
              <a
                data-mailto
                href={`mailto:${CONTACT_EMAIL}`}
                class="inline-flex items-center gap-2 border border-cream/30 text-cream font-sora text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-cream/10 transition-colors"
              >
                Try opening again
              </a>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <button
              type="button"
              data-edit
              class="inline-flex items-center gap-2 bg-cream text-forest font-sora font-semibold px-7 py-3.5 rounded-full hover:bg-teal hover:text-white transition-colors cursor-pointer"
            >
              Edit my answers
            </button>
            <a
              href="/portfolio"
              class="inline-flex items-center gap-2 border border-cream/30 text-cream font-sora font-semibold px-7 py-3.5 rounded-full hover:bg-cream/10 transition-colors"
            >
              Browse our projects
            </a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-32 flex flex-col gap-8" data-reveal>
          <!-- Live summary -->
          <div class="hidden lg:block rounded-3xl bg-forest p-7 sm:p-8 text-cream">
            <div class="flex items-center justify-between gap-4 mb-6">
              <h2 class="font-awesome text-2xl sm:text-3xl">Your inquiry</h2>
              <span
                class="font-sora text-[11px] uppercase tracking-[0.18em] text-cream/50"
                data-summary-progress>0 of 5</span
              >
            </div>
            <div class="h-1 rounded-full bg-cream/10 overflow-hidden mb-6">
              <div
                class="h-full bg-teal rounded-full transition-[width] duration-500 ease-out"
                style="width: 0%"
                data-summary-bar
              >
              </div>
            </div>
            <dl class="flex flex-col divide-y divide-cream/10 font-sora text-sm">
              {
                [
                  ["Services", "service"],
                  ["Property", "property"],
                  ["Budget", "budget"],
                  ["Timeline", "timeline"],
                  ["Contact", "contact"],
                ].map(([label, key]) => (
                  <div class="grid grid-cols-[6rem_1fr] gap-4 py-3 first:pt-0 last:pb-0">
                    <dt class="text-cream/50">{label}</dt>
                    <dd class="text-cream/40 italic" data-summary={key}>
                      Not set
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <!-- Direct contact -->
          <div>
            <h3
              class="font-sora text-xs font-semibold uppercase tracking-[0.2em] text-forest/50 mb-4"
            >
              Prefer to talk now?
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3">
              <a
                href="tel:+971567788559"
                class="group flex items-center gap-4 rounded-2xl border border-forest/10 bg-white/40 p-4 hover:border-teal/40 hover:bg-white/70 transition-colors"
              >
                <span
                  class="w-11 h-11 rounded-xl bg-teal/10 text-teal flex items-center justify-center shrink-0 group-hover:bg-teal group-hover:text-white transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                    ></path>
                  </svg>
                </span>
                <span>
                  <span
                    class="block font-sora text-xs uppercase tracking-wider text-forest/50"
                    >Call us</span
                  >
                  <span class="font-sora text-[15px] text-forest"
                    >+971 56 778 8559</span
                  >
                </span>
              </a>
              <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="group flex items-center gap-4 rounded-2xl border border-forest/10 bg-white/40 p-4 hover:border-teal/40 hover:bg-white/70 transition-colors"
              >
                <span
                  class="w-11 h-11 rounded-xl bg-teal/10 text-teal flex items-center justify-center shrink-0 group-hover:bg-teal group-hover:text-white transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </span>
                <span class="min-w-0">
                  <span
                    class="block font-sora text-xs uppercase tracking-wider text-forest/50"
                    >Email us</span
                  >
                  <span class="block font-sora text-[15px] text-forest truncate"
                    >{CONTACT_EMAIL}</span
                  >
                </span>
              </a>
            </div>
            <p
              class="inline-flex items-center gap-2 font-sora text-sm text-forest/60 mt-5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-teal"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Serving Dubai & across the UAE
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .form-step {
    margin: 0 0 2.5rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .step-legend {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-awesome);
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    line-height: 1.15;
    color: var(--color-forest);
  }
  .step-num {
    font-family: var(--font-almendra);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-olive);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 9999px;
    border: 1px solid rgb(15 51 43 / 0.15);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .step-hint {
    font-family: var(--font-sora);
    font-size: 0.875rem;
    color: rgb(15 51 43 / 0.55);
    margin-bottom: 0.9rem;
  }
  .step-legend + .step-hint {
    padding-left: 3.25rem;
    margin-top: -0.8rem;
  }
  .field-label {
    display: block;
    font-family: var(--font-sora);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-forest);
    margin-bottom: 0.5rem;
  }
  .field-error {
    font-family: var(--font-sora);
    font-size: 0.8125rem;
    color: var(--color-rust);
    margin-top: 0.6rem;
  }

  .choice {
    cursor: pointer;
  }
  .choice-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.1rem;
    border-radius: 9999px;
    border: 1px solid rgb(15 51 43 / 0.15);
    background: rgb(255 255 255 / 0.5);
    font-family: var(--font-sora);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-forest);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s;
    user-select: none;
  }
  .choice:hover .choice-pill {
    border-color: rgb(15 51 43 / 0.4);
  }
  .choice:active .choice-pill {
    transform: scale(0.97);
  }
  .choice input:checked + .choice-pill {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }
  .choice input:focus-visible + .choice-pill {
    outline: 3px solid var(--color-teal);
    outline-offset: 2px;
  }
  .choice-tick {
    display: none;
    color: var(--color-teal);
  }
  .choice input:checked + .choice-pill .choice-tick {
    display: block;
  }
  [aria-invalid="true"] {
    border-color: var(--color-rust) !important;
  }
</style>

<script>
  const CONTACT_EMAIL = "zahraalwarsan@gmail.com";

  const form = document.getElementById("inquiry-form") as HTMLFormElement;
  const sent = document.querySelector<HTMLElement>("[data-sent]")!;
  const mailtoLink = document.querySelector<HTMLAnchorElement>("[data-mailto]")!;
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]")!;
  const copyLabel = document.querySelector("[data-copy-label]")!;

  interface Inquiry {
    services: string[];
    property: string;
    location: string;
    budget: string;
    timeline: string;
    message: string;
    name: string;
    email: string;
    phone: string;
    contactMethod: string;
  }

  const read = (): Inquiry => {
    const data = new FormData(form);
    const text = (key: string) => String(data.get(key) ?? "").trim();
    return {
      services: data.getAll("service").map(String),
      property: text("property"),
      location: text("location"),
      budget: text("budget"),
      timeline: text("timeline"),
      message: text("message"),
      name: text("name"),
      email: text("email"),
      phone: text("phone"),
      contactMethod: text("contactMethod"),
    };
  };

  // ---- Email composition -------------------------------------------------

  const buildSubject = (q: Inquiry) => {
    const parts = [`New inquiry: ${q.services.join(", ")}`];
    if (q.location) parts.push(q.location);
    return parts.join(" | ");
  };

  const buildBody = (q: Inquiry) => {
    const line = (label: string, value: string) =>
      `${label} ${value || "Not specified"}`;
    return [
      "Hello Zahra Al Warsan team,",
      "",
      "I'd like to inquire about a project. Here are the details:",
      "",
      "SERVICES",
      ...q.services.map((s) => `  - ${s}`),
      "",
      "PROPERTY",
      line("Type:", q.property),
      line("Area:", q.location),
      "",
      "BUDGET & TIMELINE",
      line("Budget:", q.budget),
      line("Start:", q.timeline),
      "",
      "CONTACT",
      line("Name:", q.name),
      line("Email:", q.email),
      line("Phone:", q.phone),
      line("Prefers:", q.contactMethod),
      "",
      "PROJECT DETAILS",
      q.message || "No additional details provided.",
      "",
      "Thank you,",
      q.name,
    ].join("\n");
  };

  // ---- Live summary ------------------------------------------------------

  const summary = (key: string) =>
    document.querySelector<HTMLElement>(`[data-summary="${key}"]`);
  const progressText = document.querySelector("[data-summary-progress]");
  const progressBar = document.querySelector<HTMLElement>("[data-summary-bar]");

  const setSummary = (key: string, value: string) => {
    const el = summary(key);
    if (!el) return;
    el.textContent = value || "Not set";
    el.classList.toggle("italic", !value);
    el.classList.toggle("text-cream/40", !value);
    el.classList.toggle("text-cream", !!value);
  };

  const updateSummary = () => {
    const q = read();
    const property = [q.property, q.location].filter(Boolean).join(", ");
    const contact = q.name
      ? `${q.name}${q.contactMethod ? ` · ${q.contactMethod}` : ""}`
      : "";
    const values = {
      service: q.services.join(", "),
      property,
      budget: q.budget,
      timeline: q.timeline,
      contact,
    };
    Object.entries(values).forEach(([k, v]) => setSummary(k, v));
    const done = Object.values(values).filter(Boolean).length;
    if (progressText) progressText.textContent = `${done} of 5`;
    if (progressBar) progressBar.style.width = `${(done / 5) * 100}%`;
  };

  form.addEventListener("input", updateSummary);
  form.addEventListener("change", updateSummary);

  // Preselect a service from ?service=<slug>, e.g. links from service pages.
  const preset = new URLSearchParams(location.search).get("service");
  if (preset) {
    form
      .querySelectorAll<HTMLInputElement>('input[name="service"]')
      .forEach((input) => {
        if (input.dataset.slug === preset) input.checked = true;
      });
  }
  updateSummary();

  // ---- Validation --------------------------------------------------------

  const showError = (key: string, show: boolean) => {
    const msg = form.querySelector<HTMLElement>(`[data-error-for="${key}"]`);
    if (msg) msg.hidden = !show;
    const input = form.querySelector<HTMLInputElement>(`[name="${key}"]`);
    if (input && input.type !== "checkbox") {
      input.setAttribute("aria-invalid", String(show));
    }
  };

  const validate = (q: Inquiry) => {
    const emailInput = form.querySelector<HTMLInputElement>('[name="email"]')!;
    const checks: [string, boolean][] = [
      ["service", q.services.length > 0],
      ["name", q.name.length > 0],
      ["email", q.email.length > 0 && emailInput.validity.valid],
    ];
    checks.forEach(([key, ok]) => showError(key, !ok));
    const firstBad = checks.find(([, ok]) => !ok)?.[0];
    if (firstBad) {
      const target =
        firstBad === "service"
          ? form.querySelector<HTMLElement>('[data-group="service"]')
          : form.querySelector<HTMLElement>(`[name="${firstBad}"]`);
      target?.scrollIntoView({ behavior: "smooth", block: "center" });
      if (firstBad !== "service") {
        form.querySelector<HTMLInputElement>(`[name="${firstBad}"]`)?.focus({
          preventScroll: true,
        });
      }
      return false;
    }
    return true;
  };

  // Clear an error as soon as the visitor fixes it.
  form.addEventListener("change", (e) => {
    const name = (e.target as HTMLInputElement).name;
    if (name === "service") showError("service", read().services.length === 0);
  });
  form.addEventListener("input", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.getAttribute("aria-invalid") === "true" && input.value.trim()) {
      showError(input.name, false);
    }
  });

  // ---- Submit: hand the inquiry to the visitor's email app ---------------

  let lastInquiryText = "";

  form.addEventListener("submit", (e) => {
    e.preventDefault();

    const q = read();
    if (!validate(q)) return;

    const subject = buildSubject(q);
    const body = buildBody(q);
    const href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
      subject,
    )}&body=${encodeURIComponent(body)}`;

    lastInquiryText = `To: ${CONTACT_EMAIL}\nSubject: ${subject}\n\n${body}`;
    mailtoLink.href = href;
    copyLabel.textContent = "Copy inquiry";

    const methodPhrase: Record<string, string> = {
      "Phone call": "by phone",
      WhatsApp: "on WhatsApp",
      Email: "by email",
    };
    document.querySelector("[data-sent-name]")!.textContent =
      q.name.split(" ")[0];
    document.querySelector("[data-sent-method]")!.textContent =
      methodPhrase[q.contactMethod] ?? "by phone";

    window.location.href = href;

    form.hidden = true;
    sent.hidden = false;
    sent.scrollIntoView({ behavior: "smooth", block: "center" });
    sent.focus({ preventScroll: true });
  });

  copyBtn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(lastInquiryText);
      copyLabel.textContent = "Copied!";
    } catch {
      copyLabel.textContent = "Copy failed, select and copy manually";
    }
  });

  // Back to the form with answers intact, so nothing has to be retyped.
  document.querySelector("[data-edit]")?.addEventListener("click", () => {
    sent.hidden = true;
    form.hidden = false;
    form.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>

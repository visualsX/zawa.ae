---
const promises = [
  {
    icon: "/icons/buzz.svg",
    title: "Ready when you are",
    body: "Book a site visit at a time that suits you. We fit our schedule around yours, not the other way round.",
  },
  {
    icon: "/icons/24by7.svg",
    title: "Seamless services",
    body: "One team for design, installation and upkeep, available around the clock whenever your garden needs us.",
  },
  {
    icon: "/icons/ecofriendly.svg",
    title: "Eco-friendly practices",
    body: "Water-wise irrigation and treatments that are safe for your family, your pets and the pollinators.",
  },
  {
    icon: "/icons/backup.svg",
    title: "Backup equipment",
    body: "Spare machinery on standby, so a breakdown never delays your project or a maintenance visit.",
  },
];
---

<section class="w-full bg-cream py-20 sm:py-28 md:py-32 relative z-20 overflow-hidden">
  <div class="container-custom">
    <!-- Header -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-14 sm:mb-20"
    >
      <div class="lg:col-span-7">
        <span
          class="inline-block font-almendra text-xl sm:text-2xl text-teal mb-5"
        >
          Why Zahra Al Warsan
        </span>
        <h2
          class="font-awesome text-[2.5rem] sm:text-6xl md:text-7xl text-forest leading-[1.02]"
        >
          The new standard of <span class="text-teal">indoor &amp; outdoor</span> living
        </h2>
      </div>
      <div class="lg:col-span-5 lg:pb-2">
        <p
          class="font-sora font-light text-forest/75 text-base sm:text-lg leading-relaxed mb-7"
        >
          Four promises behind every garden we design, build and look after,
          from a single balcony to a working farm.
        </p>
        <a
          href="/contact"
          class="group/cta inline-flex items-center gap-3 bg-forest text-cream font-sora text-sm font-medium pl-6 pr-2 py-2 rounded-full hover:bg-teal transition-colors"
        >
          Get a free quote
          <span
            class="w-8 h-8 rounded-full bg-cream/15 flex items-center justify-center transition-transform group-hover/cta:translate-x-0.5"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Promise cards -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {
        promises.map((item) => (
          <li class="promise group relative flex flex-row sm:flex-col items-center sm:items-stretch gap-5 sm:gap-0 rounded-4xl bg-white/40 border border-white/70 p-3 pr-5 sm:pr-3 sm:pb-8 transition-all duration-500 hover:-translate-y-1.5 hover:bg-white/70 hover:shadow-[0_24px_48px_-24px_rgb(15_51_43/0.25)]">
            {/* Arch: the inner layer rounds the top into a true semicircle,
                the outer layer clips softer bottom corners. */}
            <div class="relative shrink-0 w-28 h-36 sm:w-auto sm:h-auto sm:aspect-[16/11] lg:aspect-[4/3.6] sm:mb-6 rounded-b-3xl overflow-hidden flex items-end justify-center pb-4 sm:pb-8">
              <span
                class="absolute inset-0 rounded-t-full bg-[#ead9b9]/60 transition-colors duration-500 group-hover:bg-mist/45"
                aria-hidden="true"
              />
              <span
                class="absolute inset-x-0 top-[18%] mx-auto w-3/5 aspect-square rounded-full bg-cream/70 blur-2xl"
                aria-hidden="true"
              />
              <img
                src={item.icon}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="promise-icon relative w-16 h-16 sm:w-28 sm:h-28 object-contain transition-transform duration-500 ease-out group-hover:-translate-y-1.5 group-hover:scale-105"
              />
            </div>
            <div class="sm:px-4 py-2 sm:py-0">
              <h3 class="font-almendra font-bold text-xl sm:text-2xl text-forest leading-tight mb-2 sm:mb-2.5">
                {item.title}
              </h3>
              <p class="font-sora font-light text-sm sm:text-[15px] text-forest/70 leading-relaxed">
                {item.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .promise,
    .promise-icon {
      transition: none;
    }
  }
</style>

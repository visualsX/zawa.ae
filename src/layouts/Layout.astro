---
import "../styles/global.css";
import Header from "../components/shared/header/index.astro";
import Footer from "../components/shared/footer/index.astro";
import SEO from "../components/shared/SEO.astro";

import type { Props as SEOProps } from "../components/shared/SEO.astro";

export type Props = Pick<
  SEOProps,
  "title" | "description" | "image" | "type" | "noindex" | "schema"
>;

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO {...props} />

    <!-- Preload only the fonts used at the top of pages; the rest load on demand. -->
    <link
      rel="preload"
      href="/fonts/sora-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/almendra-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/awesome.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
